# Banco. O caminho é relativo à pasta prisma/.
DATABASE_URL="file:../../../data/qahub.db"

# Porta da API.
PORT=3333

# Chave de cifragem das senhas da massa de teste (AES-256-GCM).
# Deixe em branco: é gerada automaticamente na primeira execução e gravada
# neste arquivo. Guarde um backup — sem ela as senhas não voltam.
# CREDENTIALS_KEY=

# Restringe o login a e-mails corporativos. Ausente = qualquer domínio.
# ALLOWED_EMAIL_DOMAINS=suaempresa.com

# Retenção do histórico de alterações, em meses. Mínimo de 12 (aplicado no
# código); o padrão é 24.
# HISTORY_RETENTION_MONTHS=24
